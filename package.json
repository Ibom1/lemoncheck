{
  "name": "lemoncheck",
  "private": true,
  "version": "0.1.0",
  "description": "A used car inspection checklist that scores the car, flags deal-breakers and suggests an offer.",
  "type": "module",
  "license": "MIT",
  "author": "Otoobong John",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
